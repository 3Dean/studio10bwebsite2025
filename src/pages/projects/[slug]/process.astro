---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import Button from '../../../components/Button.astro';

export async function getStaticPaths() {
  const processEntries = await getCollection('process');

  return processEntries.map((entry) => ({
    params: { slug: entry.data.projectSlug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'process'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const publishedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(new Date(`${entry.data.publishedDate}T00:00:00`));
const projectPath = `/projects/${entry.data.projectSlug}`;
---

<MainLayout
  title={`${entry.data.title} - Studio 10b`}
  description={entry.data.description}
  ogImage={entry.data.coverImage}
  pageType="article"
  publishedDate={entry.data.publishedDate}
>
  <article>
    <header class="bg-black pb-16 pt-36 text-white md:pb-24 md:pt-44">
      <div class="container mx-auto max-w-screen-xl px-4 md:px-8">
        <a
          href={projectPath}
          class="mb-10 inline-flex items-center gap-2 text-sm font-medium text-white/70 no-underline transition-opacity hover:text-white"
        >
          <span aria-hidden="true">←</span>
          Back to {entry.data.projectTitle}
        </a>

        <div class="max-w-4xl">
          <p class="mb-5 text-sm font-bold uppercase tracking-[0.18em] text-white/60">
            Project process
          </p>
          <h1 class="mb-7 text-4xl font-bold leading-tight md:text-6xl">
            {entry.data.title}
          </h1>
          <p class="max-w-3xl text-xl font-light leading-relaxed text-white/80 md:text-2xl">
            {entry.data.summary}
          </p>
          <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm text-white/60">
            <span>Published {publishedDate}</span>
            <span>Stage: {entry.data.stage}</span>
          </div>
        </div>
      </div>
    </header>

    <div class="bg-gray-100">
      <div class="container mx-auto max-w-screen-xl px-4 py-8 md:px-8 md:py-12">
        <div class="overflow-hidden rounded-xl">
          <img
            src={entry.data.coverImage}
            alt={entry.data.coverImageAlt}
            class="aspect-[16/8] h-auto w-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="container mx-auto max-w-screen-xl px-4 py-16 md:px-8 md:py-24">
      <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_240px] lg:items-start">
        <div class="process-article mx-auto min-w-0 max-w-3xl lg:mx-0">
          <Content />
        </div>

        {sectionHeadings.length > 0 && (
          <aside class="order-first border-b border-gray-200 pb-8 lg:order-last lg:sticky lg:top-32 lg:border-b-0 lg:border-l lg:pb-0 lg:pl-8">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-gray-500">
              On this page
            </p>
            <nav aria-label="Article sections">
              <ol class="space-y-3">
                {sectionHeadings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class="text-sm leading-snug text-gray-600 no-underline transition-colors hover:text-black"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </div>

    <footer class="bg-gray-100 py-16 md:py-20">
      <div class="container mx-auto max-w-3xl px-4 text-center md:px-8">
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-gray-500">
          Explore the result
        </p>
        <h2 class="mb-5 text-3xl font-bold md:text-4xl">
          Visit Painted Paths
        </h2>
        <p class="mx-auto mb-8 max-w-2xl text-lg leading-relaxed text-gray-600">
          Experience the completed gallery in your browser, or return to the project overview for the walkthrough and feature summary.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          {entry.data.projectUrl && (
            <Button href={entry.data.projectUrl} variant="primary" openInNewTab={true}>
              Open the Gallery
            </Button>
          )}
          <Button href={projectPath} variant="outline">
            Project Overview
          </Button>
        </div>
      </div>
    </footer>
  </article>
</MainLayout>

<style>
  .process-article :global(> p:first-child) {
    margin-top: 0;
    color: #222;
    font-size: 1.35rem;
    line-height: 1.75;
  }

  .process-article :global(h2) {
    scroll-margin-top: 8rem;
    margin-bottom: 1.5rem;
    margin-top: 4.5rem;
    color: #111;
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .process-article :global(p) {
    margin: 1.5rem 0;
    color: #444;
    font-size: 1.125rem;
    line-height: 1.85;
  }

  .process-article :global(ul),
  .process-article :global(ol) {
    margin: 1.75rem 0;
    padding-left: 1.5rem;
    color: #444;
    font-size: 1.075rem;
    line-height: 1.8;
  }

  .process-article :global(ul) {
    list-style: disc;
  }

  .process-article :global(ol) {
    list-style: decimal;
  }

  .process-article :global(li + li) {
    margin-top: 0.65rem;
  }

  .process-article :global(a) {
    color: #111;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 768px) {
    .process-article :global(h2) {
      font-size: 2.5rem;
    }
  }
</style>
