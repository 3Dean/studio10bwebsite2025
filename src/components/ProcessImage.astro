---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-12">
  <div class="overflow-hidden rounded-xl bg-gray-100">
    <img
      src={src}
      alt={alt}
      loading="lazy"
      class="h-auto w-full object-cover"
    />
  </div>
  {caption && (
    <figcaption class="mt-3 text-sm leading-relaxed text-gray-500">
      {caption}
    </figcaption>
  )}
</figure>
