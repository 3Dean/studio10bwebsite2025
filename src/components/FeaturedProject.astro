---
interface Props {
  eyebrow: string;
  projectName: string;
  subtitle: string;
  description: string;
  imageUrl: string;
  imageAlt?: string;
  buttonText?: string;
  buttonUrl: string;
}

const {
  eyebrow,
  projectName,
  subtitle,
  description,
  imageUrl,
  imageAlt = `${projectName} project preview`,
  buttonText = "View Case Study",
  buttonUrl,
} = Astro.props;
---

<section class="featured-project" aria-labelledby="featured-project-title">
  <div class="featured-project__container">
    <div class="featured-project__rule" aria-hidden="true"></div>

    <div class="featured-project__layout">
      <div class="featured-project__content">
        <p class="featured-project__eyebrow">{eyebrow}</p>
        <h2 id="featured-project-title" class="featured-project__title">{projectName}</h2>
        <p class="featured-project__summary">{subtitle}</p>
        <p class="featured-project__description">{description}</p>
        <a class="featured-project__link" href={buttonUrl}>
          {buttonText} <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="featured-project__media">
        <img
          src={imageUrl}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .featured-project {
    background: #fafafa;
    color: #111;
    padding: clamp(3.5rem, 7vw, 6.5rem) 1rem;
  }

  .featured-project__container {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
    margin: 0 auto;
    max-width: 1280px;
  }

  .featured-project__rule {
    align-self: stretch;
    background: #d7d7d7;
    border-radius: 999px;
  }

  .featured-project__content {
    max-width: 680px;
  }

  .featured-project__layout {
    align-items: center;
    display: grid;
    gap: clamp(2.5rem, 5vw, 5rem);
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
  }

  .featured-project__media {
    margin: 0;
    min-width: 0;
  }

  .featured-project__media img {
    aspect-ratio: 16 / 9;
    border-radius: 0.75rem;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 12%);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .featured-project__eyebrow {
    font-size: clamp(0.875rem, 1.6vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.25;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .featured-project__title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }

  .featured-project__summary {
    font-size: clamp(1.2rem, 2.1vw, 1.65rem);
    font-weight: 600;
    line-height: 1.45;
    margin: 0 0 1.75rem;
    max-width: 1100px;
  }

  .featured-project__description {
    color: #333;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    margin: 0 0 1.75rem;
    max-width: 680px;
  }

  .featured-project__link {
    color: inherit;
    display: inline-flex;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 600;
    gap: 0.35rem;
    line-height: 1.3;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .featured-project__link span {
    transition: transform 180ms ease;
  }

  .featured-project__link:hover {
    text-decoration: underline;
  }

  .featured-project__link:hover span {
    transform: translateX(0.25rem);
  }

  .featured-project__link:focus-visible {
    border-radius: 2px;
    outline: 3px solid #ff3b30;
    outline-offset: 5px;
  }

  @media (max-width: 640px) {
    .featured-project__container {
      grid-template-columns: 4px minmax(0, 1fr);
      gap: 1.25rem;
    }

    .featured-project__eyebrow {
      margin-bottom: 0.75rem;
    }

    .featured-project__summary,
    .featured-project__description {
      margin-bottom: 1.4rem;
    }
  }

  @media (max-width: 960px) {
    .featured-project__layout {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .featured-project__content {
      max-width: 760px;
    }

    .featured-project__media {
      max-width: 760px;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-project__link span {
      transition: none;
    }
  }
</style>
