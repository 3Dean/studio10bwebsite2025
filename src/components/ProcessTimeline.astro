---
interface TimelineItem {
  date: string;
  title: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="process-timeline my-12 border-l border-gray-300 pl-6 md:pl-8">
  {items.map((item) => (
    <li class="relative pb-9 last:pb-0">
      <span
        class="absolute -left-[1.92rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-black md:-left-[2.42rem]"
        aria-hidden="true"
      ></span>
      <p class="m-0 text-xs font-bold uppercase tracking-[0.14em] text-gray-500">
        {item.date}
      </p>
      <h3 class="mb-2 mt-2 text-xl font-bold text-gray-900">
        {item.title}
      </h3>
      <p class="m-0 text-base leading-relaxed text-gray-600">
        {item.description}
      </p>
    </li>
  ))}
</ol>

<style>
  .process-timeline :global(p) {
    margin: 0;
  }
</style>
