---
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: 2 | 3;
}

const { images, columns = 2 } = Astro.props;
const gridClasses = columns === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---

<div class={`my-12 grid grid-cols-1 gap-5 ${gridClasses}`}>
  {images.map((image) => (
    <figure>
      <div class="aspect-[4/3] overflow-hidden rounded-xl bg-gray-100">
        <img
          src={image.src}
          alt={image.alt}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]"
        />
      </div>
      {image.caption && (
        <figcaption class="mt-3 text-sm leading-relaxed text-gray-500">
          {image.caption}
        </figcaption>
      )}
    </figure>
  ))}
</div>
