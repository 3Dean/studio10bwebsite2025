---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tailwind.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  pageType?: 'website' | 'article';
  publishedDate?: string;
}

const {
  title,
  description = "Studio 10b - Real-Time 3D, Motion Design, and Immersive Experiences",
  ogImage,
  canonicalUrl,
  pageType = 'website',
  publishedDate
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteOrigin).toString();
const socialImage = ogImage ? new URL(ogImage, siteOrigin).toString() : undefined;
const fullTitle = title.includes('Studio 10b') ? title : `${title} | Studio 10b`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Studio 10b" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {pageType === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@300;400;800&display=swap" rel="stylesheet">
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
